# EditorConfig for jsonlens. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Vendored third party sources are kept byte-for-byte identical to upstream.
[include/jsonlens/detail/cjson/*]
trim_trailing_whitespace = false
insert_final_newline = false
